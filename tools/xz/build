version=5.8.1
source=(http://tukaani.org/xz/xz-$version.tar.xz)

do_build() {
cd xz-$version

./configure --prefix=/usr                     \
            --host=$LFS_TGT                   \
            --build=$(build-aux/config.guess) \
            --disable-static                  \
            --docdir=/usr/share/doc/xz-5.8.1

make
make DESTDIR=$LFS install

rm -v $LFS/usr/lib/liblzma.la
}
