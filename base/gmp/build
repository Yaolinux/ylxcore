name=gmp
version=6.3.0
source=(https://ftp.gnu.org/gnu/gmp/gmp-6.3.0.tar.xz)

do_build() {
	cd gmp-$version

	sed -i '/long long t1;/,+1s/()/(...)/' configure

	./configure --prefix=/usr    \
            --enable-cxx     \
            --disable-static \
            --docdir=/usr/share/doc/gmp-$version

	make
	make html

	make install
	make install-html
}
