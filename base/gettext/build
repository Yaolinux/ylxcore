name=gettext
version=0.26
source=(https://ftp.gnu.org/gnu/gettext/gettext-$version.tar.xz)

do_build() {
	cd gettext-$version

	./configure --prefix=/usr    \
            --disable-static \
            --docdir=/usr/share/doc/gettext-$version

	make
	make install
	chmod -v 0755 /usr/lib/preloadable_libintl.so
}
