name=expat
version=2.7.1
source=(https://prdownloads.sourceforge.net/expat/expat-$version.tar.xz)

do_build() {
	cd expat-$version
	
	./configure --prefix=/usr    \
            --disable-static \
            --docdir=/usr/share/doc/expat-$version

	make
	make install

	install -v -m644 doc/*.{html,css} /usr/share/doc/expat-$version
}
