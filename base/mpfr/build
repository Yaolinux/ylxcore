name=mpfr
version=4.2.2
source=(https://www.mpfr.org/mpfr-$version/mpfr-$version.tar.xz)

do_build() {
	cd mpfr-$version

	./configure --prefix=/usr        \
            --disable-static     \
            --enable-thread-safe \
            --docdir=/usr/share/doc/mpfr-$version

	make
	make html

	make install
	make install-html

}
