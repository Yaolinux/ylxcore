name=libelf
version=3.12
tarversion=0.193
source=(https://sourceware.org/ftp/elfutils/$version/elfutils-$tarversion.tar.bz2)

do_build() {
	cd elfutils-$tarversion

	./configure --prefix=/usr                \
            --disable-debuginfod         \
            --enable-libdebuginfod=dummy

	make

	make -C libelf install
	install -vm644 config/libelf.pc /usr/lib/pkgconfig
	rm /usr/lib/libelf.a
}
