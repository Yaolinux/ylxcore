name=python
version=3.13.7
source=(https://www.python.org/ftp/python/$version/Python-$version.tar.xz)

do_build() {
	cd Python-$version

	./configure --prefix=/usr          \
            --enable-shared        \
            --with-system-expat    \
            --enable-optimizations \
            --without-static-libpython

	make
	make install

	install -v -dm755 /usr/share/doc/python-3.13.7/html

}
