name=flex
version=2.6.4
source=(https://github.com/westes/flex/releases/download/v$version/flex-$version.tar.gz)

do_build() {
	cd flex-$version

	./configure --prefix=/usr \
            --docdir=/usr/share/doc/flex-$version \
            --disable-static
	
	make
	make install

	ln -s flex /usr/bin/lex
}
