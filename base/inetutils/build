name=inetutils
version=2.6
source=(https://ftp.gnu.org/gnu/inetutils/inetutils-$version.tar.xz)

do_build() {
	cd inetutils-$version

	sed -i 's/def HAVE_TERMCAP_TGETENT/ 1/' telnet/telnet.c

	./configure --prefix=/usr        \
            --bindir=/usr/bin    \
            --localstatedir=/var \
            --disable-logger     \
            --disable-whois      \
            --disable-rcp        \
            --disable-rexec      \
            --disable-rlogin     \
            --disable-rsh        \
            --disable-servers

	make
	make install

	mv -v /usr/{,s}bin/ifconfig
}
