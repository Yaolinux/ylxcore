name=attr
version=2.5.2
source=(https://download.savannah.gnu.org/releases/attr/attr-$version.tar.gz)

do_build() {
	cd attr-$version

	./configure --prefix=/usr     \
            --disable-static  \
            --sysconfdir=/etc \
            --docdir=/usr/share/doc/attr-$version

	make
	make install

}
