name=bash
version=5.3
source=(https://ftp.gnu.org/gnu/bash/bash-$version.tar.gz)

do_build() {
	cd bash-$version

	./configure --prefix=/usr                      \
            --docdir=/usr/share/doc/bash-$version \
            --without-bash-malloc              \
            --with-installed-readline

	make
	make install

}
