name=procps
version=4.0.5
source=(https://sourceforge.net/projects/procps-ng/files/Production/procps-ng-$version.tar.xz)

do_build() {
	cd procps-ng-$version

	./configure --prefix=/usr                           \
            --docdir=/usr/share/doc/procps-ng-$version \
            --disable-static                        \
            --disable-kill                          \
            --enable-watch8bit                      \
            --with-systemd

	make
	make install

}
